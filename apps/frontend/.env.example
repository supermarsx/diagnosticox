# API & Routing
# Preferred key used by frontend services:
VITE_API_URL=http://localhost:3000/api
# Backward-compatible alias (optional):
VITE_API_BASE_URL=http://localhost:3000/api
VITE_TENANT_ID=demo-org

# External Services (keep secrets local)
VITE_ICD_API_KEY=your-icd-key
VITE_DRUGBANK_API_KEY=your-drugbank-key
VITE_AI_PROVIDER_KEY=your-ai-provider-key
VITE_AI_PROVIDER_BASE_URL=https://api.your-ai-provider.com

# Feature Flags
VITE_FEATURE_FHIR_SYNC=false
VITE_FEATURE_AI_ASSIST=false

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Use 'postgresql', 'sqlite', or 'json'
DB_TYPE=sqlite

# PostgreSQL Configuration (when DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical_diagnosis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# SQLite Configuration (when DB_TYPE=sqlite)
SQLITE_DB_PATH=./research/medical_diagnosis.db

# JSON Configuration (when DB_TYPE=json)
# Stores a SQL.js snapshot in a JSON container for easy backup/inspection
JSON_DB_PATH=./research/medical_diagnosis.json

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

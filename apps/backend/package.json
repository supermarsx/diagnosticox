{
  "name": "diagnosticox-backend",
  "version": "1.0.0",
  "description": "Medical diagnosis application backend with PostgreSQL/SQLite support",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:deps": "pnpm --filter @diagnosticox/shared-types run build",
    "build": "pnpm run build:deps && tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrations/run.ts",
    "seed": "tsx src/seeds/run.ts",
    "lint": "eslint 'src/**/*.{ts,js}' --ext .ts --max-warnings 0",
    "test": "vitest",
    "test:ci": "pnpx tsx src/migrations/run.ts && vitest run --coverage"
  },
  "dependencies": {
    "@diagnosticox/shared-types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^8.18.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "sql.js": "^1.8.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.58.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.47.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/sdk-trace-base": "^1.0.0",
    "@opentelemetry/semantic-conventions": "^1.13.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.9.1",
    "@typescript-eslint/parser": "^7.9.1",
    "eslint": "^8.57.0",
    "ioredis": "^5.3.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}

        "options": {
          "limit": 20,
          "datasource": { "type": "tempo", "uid": "Tempo" }
        }
      },
      {
        "type": "timeseries",
        "title": "Trace latency (p50/p95) - via Prometheus if available",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 3 },
        "targets": [],
        "fieldConfig": { "defaults": {}, "overrides": [] }
      },
      {
        "type": "stat",
        "title": "Failed spans ratio (example)",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 13 },
        "targets": [],
        "options": { "colorMode": "value" }
      }
    ]
  },

{
  "name": "diagnosticox-monorepo",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "scripts": {
    "lint": "pnpm --filter diagnosticox-frontend run lint",
    "format:check": "pnpm --filter diagnosticox-frontend run format:check",
    "test": "pnpm --filter diagnosticox-frontend run test",
    "test:ci": "pnpm --filter diagnosticox-frontend run test",
    "build": "pnpm --filter diagnosticox-frontend run build",
    "build:prod": "pnpm --filter diagnosticox-frontend run build:prod",
    "build:analyze": "pnpm --filter diagnosticox-frontend run build:analyze",
    "dev:backend": "pnpm --filter diagnosticox-backend run dev",
    "dev:frontend": "pnpm --filter diagnosticox-frontend run dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "down:infra": "docker compose -f docker-compose.dev.yml down",
    "dev:light": "node ./scripts/dev-light.js",
    "validate": "pnpm --filter diagnosticox-backend run build && pnpm --filter diagnosticox-frontend run build"
  }
}
